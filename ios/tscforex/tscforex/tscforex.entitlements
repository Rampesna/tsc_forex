<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sign in with Apple (requires the capability enabled on the App ID). -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Passkeys (WebAuthn) + credential autofill. RP ID on the backend is
	     tsc.talhacan.com; its /.well-known/apple-app-site-association is served
	     by the web nginx (proxied to the API), so web + iOS share one RP. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:tsc.talhacan.com</string>
	</array>
	<!-- APNs background push. Xcode toggles this to "production" for release. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
