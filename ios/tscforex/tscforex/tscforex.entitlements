<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sign in with Apple (requires the capability enabled on the App ID). -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Passkeys (WebAuthn) + credential autofill. RP ID is the registrable
	     parent (talhacan.com) so passkeys are shared with the web app; the API
	     subdomain is kept for AASA compatibility. AASA must be served at
	     https://talhacan.com/.well-known/apple-app-site-association. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:talhacan.com</string>
		<string>webcredentials:tsc-api.talhacan.com</string>
	</array>
	<!-- APNs background push. Xcode toggles this to "production" for release. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
