# Copy to .env and adjust. Never commit real secrets.
# Env vars override YAML. Nested keys use APP_ prefix + underscore:
#   app.environment      → APP_APP_ENVIRONMENT
#   server.port          → APP_SERVER_PORT
#   database.password    → APP_DATABASE_PASSWORD
#   redis.addr           → APP_REDIS_ADDR
#   jwt.secret           → APP_JWT_SECRET
#   provider.primary     → APP_PROVIDER_PRIMARY

APP_APP_ENVIRONMENT=development
APP_SERVER_PORT=8080
APP_SERVER_MODE=debug

APP_DATABASE_HOST=localhost
APP_DATABASE_PORT=5432
APP_DATABASE_USER=tsc_forex
APP_DATABASE_PASSWORD=tsc_forex
APP_DATABASE_NAME=tsc_forex
APP_DATABASE_SSL_MODE=disable

APP_REDIS_ADDR=localhost:6379
APP_REDIS_PASSWORD=
APP_REDIS_DB=0
APP_REDIS_PUBSUB_CHANNEL=gold:gram:updates

APP_NATS_ENABLED=false
APP_NATS_URL=nats://localhost:4222

APP_PROVIDER_PRIMARY=mock
APP_PROVIDER_MOCK_ENABLED=true

# Real providers (enable one and set primary accordingly)
APP_PROVIDER_TWELVEDATA_ENABLED=false
APP_PROVIDER_TWELVEDATA_API_KEY=
APP_PROVIDER_FINNHUB_ENABLED=false
APP_PROVIDER_FINNHUB_API_KEY=
APP_PROVIDER_POLYGON_ENABLED=false
APP_PROVIDER_POLYGON_API_KEY=
APP_PROVIDER_ALPHAVANTAGE_ENABLED=false
APP_PROVIDER_ALPHAVANTAGE_API_KEY=

APP_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY_32+
APP_JWT_ISSUER=tsc_forex

APP_CACHE_LATEST_PRICE_TTL=60s
APP_CACHE_LATEST_PRICE_KEY=gold:gram:latest

APP_LOG_LEVEL=info
APP_LOG_ENCODING=json
APP_LOG_DEVELOPMENT=true

APP_METRICS_ENABLED=true
APP_TRACING_ENABLED=false

# TSC AI (server-side only). Create a restricted project key and never expose it
# to the React/iOS/Android clients.
APP_AI_ENABLED=false
APP_AI_API_KEY=
APP_AI_MODEL=gpt-5.6-sol
APP_AI_TIMEOUT=55s
APP_AI_MAX_OUTPUT_TOKENS=8000
APP_AI_REASONING_EFFORT=high
APP_AI_WEB_SEARCH=true
APP_AI_SEARCH_CONTEXT=high
APP_AI_MAX_TOOL_CALLS=4
